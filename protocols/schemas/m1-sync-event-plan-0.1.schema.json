{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kineimu.org/schemas/m1-sync-event-plan-0.1.schema.json",
  "title": "KineIMU Shoulder M1 synchronization event plan 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "method_version",
    "fixture",
    "raw_streams",
    "events"
  ],
  "properties": {
    "schema_version": {"const": "kineimu.m1.sync-event-plan/0.1"},
    "session_id": {"type": "string", "minLength": 1},
    "method_version": {"type": "string", "minLength": 1},
    "fixture": {"$ref": "#/$defs/fixture"},
    "raw_streams": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/raw_stream"},
      "allOf": [
        {"contains": {"properties": {"node_id": {"const": "A"}}, "required": ["node_id"]}},
        {"contains": {"properties": {"node_id": {"const": "B"}}, "required": ["node_id"]}}
      ]
    },
    "events": {
      "type": "array",
      "minItems": 6,
      "items": {"$ref": "#/$defs/event"}
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "raw_stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "path", "sha256"],
      "properties": {
        "node_id": {"type": "string", "enum": ["A", "B"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "phase",
        "role",
        "common_time_us",
        "reference_method",
        "reference_resolution_us",
        "reference_uncertainty_us",
        "observations"
      ],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "enum": ["beginning", "middle", "end"]},
        "role": {"type": "string", "enum": ["fit", "held_out"]},
        "common_time_us": {"type": "number", "minimum": 0},
        "reference_method": {"type": "string", "minLength": 1},
        "reference_resolution_us": {"type": "number", "minimum": 0},
        "reference_uncertainty_us": {"type": "number", "minimum": 0},
        "observations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/observation"},
          "allOf": [
            {"contains": {"properties": {"node_id": {"const": "A"}}, "required": ["node_id"]}},
            {"contains": {"properties": {"node_id": {"const": "B"}}, "required": ["node_id"]}}
          ]
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "clock_epoch",
        "device_time_us",
        "localization_method",
        "localization_resolution_us",
        "localization_uncertainty_us",
        "raw_sha256",
        "sample_sequence"
      ],
      "properties": {
        "node_id": {"type": "string", "enum": ["A", "B"]},
        "clock_epoch": {"type": "integer", "minimum": 0},
        "device_time_us": {"type": "integer", "minimum": 0},
        "localization_method": {"type": "string", "minLength": 1},
        "localization_resolution_us": {"type": "number", "minimum": 0},
        "localization_uncertainty_us": {"type": "number", "minimum": 0},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sample_sequence": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
